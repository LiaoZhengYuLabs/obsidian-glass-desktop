{
  "profileName": "obsidian-glass-safe",
  "taskName": "Obsidian Glass Desktop",
  "projectRoot": ".",
  "startupDelaySeconds": 2,
  "useScheduledTask": true,
  "useStartupFolderShortcut": false,
  "notes": "Safe template: components are disabled until the user verifies optional dependencies and chooses a profile.",
  "components": [
    {
      "id": "dashboard",
      "displayName": "Ambient dashboard and system controls",
      "enabled": false,
      "script": "src/components/dashboard/start.ps1",
      "arguments": ["-NoStartup"],
      "delaySeconds": 0
    },
    {
      "id": "sidebar",
      "displayName": "Left application rail and live preview",
      "enabled": false,
      "script": "src/components/sidebar/start.ps1",
      "arguments": ["-NoStartup"],
      "delaySeconds": 1
    },
    {
      "id": "dock",
      "displayName": "Obsidian AI Dock",
      "enabled": false,
      "script": "src/components/dock/start.ps1",
      "arguments": ["-NoStartup"],
      "delaySeconds": 2
    },
    {
      "id": "ambient-dock-visibility",
      "displayName": "Dock visibility controller",
      "enabled": false,
      "script": "src/components/ambient/start.ps1",
      "arguments": ["-NoStartup"],
      "delaySeconds": 3
    },
    {
      "id": "topbar",
      "displayName": "Seelen and MyDockFinder top bar integration",
      "enabled": false,
      "script": "src/components/topbar/install_topbar.ps1",
      "arguments": [],
      "delaySeconds": 0,
      "requiresExplicitExternalConfig": true
    }
  ]
}
