<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card"
        CornerRadius="14"
        Background="#14FFFFFF"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        Padding="14,10"
        RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#C8000000" BlurRadius="13" ShadowDepth="3" Opacity="0.48"/></Border.Effect>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="WorkspaceDot" Width="5" Height="5" Fill="#FFA7F3D0" Margin="0,3,7,0"/>
                <TextBlock x:Name="WorkspaceTitleText" Text="工作区状态" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="SessionModeText" Text="桌面模式" Foreground="#FFFDE68A" FontSize="9" Margin="12,8,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Width="1" Background="#1FFFFFFF" Margin="0,5"/>
        <StackPanel Grid.Column="2" Margin="14,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="ActiveAppText" Text="桌面" Foreground="#E8FFFFFF" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="WindowTitleText" Text="等待工作窗口" Foreground="#72FFFFFF" FontSize="8" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="本次时长" Foreground="#52FFFFFF" FontSize="7" HorizontalAlignment="Right"/>
            <TextBlock x:Name="SessionTimeText" Text="00:00" Foreground="#BFFFFFFF" FontSize="12" FontWeight="Light" HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Border>
