<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card"
        CornerRadius="14"
        Background="#12FFFFFF"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        Padding="15,11"
        RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#C8000000" BlurRadius="11" ShadowDepth="3" Opacity="0.44"/></Border.Effect>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="83"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="AiTitleText" Text="AI 核心" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Ellipse x:Name="CoreDot" Width="5" Height="5" Fill="#FFA7F3D0" Margin="0,3,6,0" VerticalAlignment="Top"/>
                <TextBlock Text="本地状态" Foreground="#70FFFFFF" FontSize="8"/>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="AgentsPanel" Grid.Row="1"/>
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="17"/><RowDefinition Height="5"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TaskText" Text="桌面组件视觉层" Foreground="#CCFFFFFF" FontSize="9" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ProgressText" Grid.Column="1" Text="82%" Foreground="#FFFDE68A" FontSize="9"/>
            </Grid>
            <TextBlock x:Name="ProjectText" Grid.Row="1" Text="黑曜石智能桌面" Foreground="#73FFFFFF" FontSize="8" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Row="2" Height="3" CornerRadius="2" Background="#24FFFFFF">
                <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="#FFFDE68A"/>
            </Border>
        </Grid>
    </Grid>
</Border>
