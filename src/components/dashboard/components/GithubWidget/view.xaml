<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card"
        CornerRadius="14"
        Background="#12FFFFFF"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        Padding="13,11"
        RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#C8000000" BlurRadius="11" ShadowDepth="3" Opacity="0.44"/></Border.Effect>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="22"/><RowDefinition Height="14"/><RowDefinition Height="14"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="GithubTitleText" Grid.Row="0" Text="GITHUB 状态" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold"/>
        <TextBlock x:Name="RepositoryText" Grid.Row="1" Text="未连接本地仓库" Foreground="#E6FFFFFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="BranchText" Grid.Row="2" Text="分支  --" Foreground="#80FFFFFF" FontSize="8" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="CommitsText" Grid.Row="3" Text="提交  --" Foreground="#80FFFFFF" FontSize="8" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ProjectText" Grid.Row="4" Text="项目  --" Foreground="#6BFFFFFF" FontSize="8" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="LatestCommitText" Grid.Row="5" Text="可在 github.json 配置仓库路径" Foreground="#A6FFFFFF" FontSize="8" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" MaxHeight="24"/>
    </Grid>
</Border>
