<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card"
        CornerRadius="14"
        Background="#12FFFFFF"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        Padding="10,9"
        RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#C8000000" BlurRadius="11" ShadowDepth="3" Opacity="0.44"/></Border.Effect>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="SystemTitleText" Text="电脑状态" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DeviceInfoText" Text="正在读取设备信息" Foreground="#5FFFFFFF" FontSize="7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,2,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="68" Height="68" Stroke="#22FFFFFF" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path x:Name="CpuArc" Stroke="#FFD9D9D9" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="CpuValue" Text="--%" Foreground="#FFFFFFFF" FontSize="17" FontWeight="Light" HorizontalAlignment="Center"/>
                    <TextBlock Text="处理器" Foreground="#70FFFFFF" FontSize="7" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Margin="7,4,0,2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/></Grid.RowDefinitions>
                <TextBlock x:Name="GpuValue" Grid.Row="0" Grid.Column="0" Text="显卡  --" Foreground="#9FFFFFFF" FontSize="8" VerticalAlignment="Center"/>
                <TextBlock x:Name="RamValue" Grid.Row="0" Grid.Column="1" Text="内存  --" Foreground="#9FFFFFFF" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="SsdValue" Grid.Row="1" Grid.Column="0" Text="磁盘  --" Foreground="#8FFFFFFF" FontSize="8" VerticalAlignment="Center"/>
                <TextBlock x:Name="BatteryValue" Grid.Row="1" Grid.Column="1" Text="电池  --" Foreground="#8FFFFFFF" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="TemperatureValue" Grid.Row="2" Grid.Column="0" Text="温度  --" Foreground="#75FFFFFF" FontSize="8" VerticalAlignment="Center"/>
                <TextBlock x:Name="NetworkValue" Grid.Row="2" Grid.Column="1" Text="网络  --" Foreground="#75FFFFFF" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Border>
