<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card"
        CornerRadius="14"
        Background="#12FFFFFF"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        Padding="15,11"
        RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#C8000000" BlurRadius="11" ShadowDepth="3" Opacity="0.44"/></Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="19"/>
            <RowDefinition Height="57"/>
            <RowDefinition Height="21"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeWeatherTitleText" Text="时间与天气" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Ellipse x:Name="WeatherDot" Width="5" Height="5" Fill="#FFFDE68A" Margin="0,3,6,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="LocationText" Text="揭阳市 / 榕城区" Foreground="#8CFFFFFF" FontSize="8"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeText" Text="09:30" Foreground="#FFFFFFFF" FontFamily="Segoe UI Variable Display" FontSize="40" FontWeight="Light" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="DateText" Text="2026/07/13" Foreground="#D9FFFFFF" FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock x:Name="WeekdayText" Text="星期一" Foreground="#7AFFFFFF" FontSize="9" HorizontalAlignment="Right" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ConditionText" Text="待配置天气服务" Foreground="#A6FFFFFF" FontSize="9" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TemperatureText" Grid.Column="1" Text="--°" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold"/>
        </Grid>
        <Grid Grid.Row="3" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="HumidityText" Text="湿度  --" Foreground="#7AFFFFFF" FontSize="8" Margin="0,0,12,0"/>
            <TextBlock x:Name="AirQualityText" Grid.Column="1" Text="空气  --" Foreground="#7AFFFFFF" FontSize="8"/>
            <TextBlock x:Name="WeatherUpdatedText" Grid.Column="2" Text="未同步" Foreground="#63FFFFFF" FontSize="8" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Border>
