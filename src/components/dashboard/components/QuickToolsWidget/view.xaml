<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card"
        CornerRadius="14"
        Background="#12FFFFFF"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        Padding="12,10"
        RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#C8000000" BlurRadius="11" ShadowDepth="3" Opacity="0.44"/></Border.Effect>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="QuickToolsTitleText" Text="快捷工具" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold"/>
            <Ellipse x:Name="ToolsDot" Grid.Column="1" Width="5" Height="5" Fill="#FFA7F3D0" Margin="0,3,0,0" VerticalAlignment="Top"/>
        </Grid>
        <WrapPanel x:Name="ToolsPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" ItemWidth="38" ItemHeight="38"/>
        <TextBlock x:Name="ToolsStatusText" Grid.Row="2" Text="正在扫描本机程序" Foreground="#63FFFFFF" FontSize="8" HorizontalAlignment="Center"/>
    </Grid>
</Border>
