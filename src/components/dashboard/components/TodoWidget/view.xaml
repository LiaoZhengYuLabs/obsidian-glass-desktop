<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card"
        CornerRadius="14"
        Background="#12FFFFFF"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        Padding="11,8"
        RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#C8000000" BlurRadius="11" ShadowDepth="3" Opacity="0.44"/></Border.Effect>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition Height="23"/><RowDefinition Height="*"/><RowDefinition Height="17"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TodoTitleText" Text="每日计划" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold"/>
            <Ellipse x:Name="TodoDot" Grid.Column="2" Width="5" Height="5" Fill="#FFFDE68A" Margin="0,3,8,0" VerticalAlignment="Top"/>
            <Button x:Name="AddTodoButton" Grid.Column="3" Width="23" Height="19" Content="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#CFFFFFFF" Background="#0CFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Cursor="Hand" ToolTip="新增计划" Style="{DynamicResource IconButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <Button x:Name="PreviousDayButton" Grid.Column="0" Width="20" Height="19" Content="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#88FFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="前一天" Style="{DynamicResource IconButtonStyle}"/>
            <TextBlock x:Name="TodoDateText" Grid.Column="1" Text="今天 · 07月14日" Foreground="#DFFFFFFF" FontFamily="Segoe UI Variable Display" FontSize="12" FontWeight="Light" VerticalAlignment="Center"/>
            <Button x:Name="TodayButton" Grid.Column="2" Width="20" Height="19" Content="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#88FFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="回到今天" Style="{DynamicResource IconButtonStyle}"/>
            <Button x:Name="NextDayButton" Grid.Column="3" Width="20" Height="19" Content="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#88FFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="后一天" Style="{DynamicResource IconButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,2,0,1">
            <ScrollViewer x:Name="TasksScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TasksPanel"/>
            </ScrollViewer>
            <Border x:Name="TodoInputPanel" Visibility="Collapsed" Background="#EE111419" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="7" Padding="7" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TodoInputText" Grid.Column="0" Height="24" MaxLength="80" Background="#10FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Foreground="#EFFFFFFF" CaretBrush="#FFFFFFFF" FontSize="9" Padding="6,2" VerticalContentAlignment="Center" ToolTip="输入计划内容"/>
                    <Button x:Name="ConfirmTodoButton" Grid.Column="1" Width="22" Height="22" Margin="4,1,0,1" Content="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#FFA7F3D0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="添加" Style="{DynamicResource IconButtonStyle}"/>
                    <Button x:Name="CancelTodoButton" Grid.Column="2" Width="22" Height="22" Margin="4,1,0,1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#8FFFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="取消" Style="{DynamicResource IconButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TodoSummaryText" Text="已完成 0/0" Foreground="#63FFFFFF" FontSize="8" VerticalAlignment="Bottom"/>
            <TextBlock x:Name="TodoEnergyText" Grid.Column="1" Text="今日能量 0%" Foreground="#7AA7F3D0" FontSize="8" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Border>
