<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card"
        CornerRadius="14"
        Background="#14FFFFFF"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        Padding="13,11"
        RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#C8000000" BlurRadius="13" ShadowDepth="3" Opacity="0.48"/></Border.Effect>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MediaTitleLabel" Text="正在播放" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Ellipse x:Name="MediaDot" Width="5" Height="5" Fill="#58FFFFFF" Margin="0,3,6,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="MediaStateText" Text="空闲" Foreground="#70FFFFFF" FontSize="8"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="MediaAppText" Grid.Row="1" Text="未检测到媒体应用" Foreground="#8FFFFFFF" FontSize="8" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="MediaTitleText" Grid.Row="2" Text="桌面保持安静" Foreground="#E8FFFFFF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" VerticalAlignment="Center"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MediaModeText" Text="安静模式" Foreground="#63FFFFFF" FontSize="8" VerticalAlignment="Center"/>
            <Button x:Name="MediaPlayPauseButton" Grid.Column="1" Width="30" Height="24" Content="&#x23EF;" Foreground="#CFFFFFFF" Background="#0FFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Cursor="Hand" ToolTip="播放或暂停" Style="{DynamicResource IconButtonStyle}"/>
        </Grid>
    </Grid>
</Border>
