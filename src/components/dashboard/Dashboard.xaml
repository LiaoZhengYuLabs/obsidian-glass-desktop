<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="DashboardWindow"
        Title="macOS 桌面小组件"
        Width="350"
        Height="916"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="WidgetObsidianBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E70A0D14" Offset="0"/>
            <GradientStop Color="#D51A2030" Offset="0.46"/>
            <GradientStop Color="#E607090E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WidgetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B8EAF4FF" Offset="0"/>
            <GradientStop Color="#707CB5F2" Offset="0.48"/>
            <GradientStop Color="#7DB99BEA" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="WidgetCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource WidgetObsidianBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WidgetEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5C7DC7FF" BlurRadius="26" ShadowDepth="5" Opacity="0.58"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WidgetIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#302B3A58"/>
            <Setter Property="BorderBrush" Value="#628CB9E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F5FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#5B31527C"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B8D8ECFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.66"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaTransportButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFE2FFD5"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="ButtonSurface" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                            <Border x:Name="HoverSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="#62FFFFFF"/>
                                <Setter TargetName="HoverSurface" Property="BorderBrush" Value="#B8D6FFBC"/>
                                <Setter TargetName="HoverSurface" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="ButtonSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaPlayButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFB2F49A" Offset="0"/>
                        <GradientStop Color="#FF4B9B6A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#DFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#FF75D792" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.38"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="ButtonSurface" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                            <Border x:Name="PlaySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20"/>
                            <Ellipse Width="25" Height="11" Fill="#42FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlaySurface" Property="Opacity" Value="0.92"/>
                                <Setter TargetName="ButtonSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.07" ScaleY="1.07"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaLanguageButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#FFD6FFD5"/>
            <Setter Property="Background" Value="#3C6EB26D"/>
            <Setter Property="BorderBrush" Value="#8FB8E8B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="6.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="LanguageSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LanguageSurface" Property="Background" Value="#C8FFFFFF"/>
                                <Setter TargetName="LanguageSurface" Property="BorderBrush" Value="#FFD7F8C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TodoCheckStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="22" Height="22">
                            <Ellipse x:Name="Ring" Fill="#16000000" Stroke="#58FFFFFF" StrokeThickness="1.2"/>
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#FF303238" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#B8FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="#E8FFFFFF"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#FFFFFFFF"/>
                                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WidgetRoot" Width="350" Height="916" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="142"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="124"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="124"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="124"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="142"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <Border x:Name="WeatherCard" Grid.Row="0" Style="{StaticResource WidgetCardStyle}" Padding="14,11" Cursor="SizeAll">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="我的位置" Foreground="#DFFFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WeatherLocationText" Text="揭阳市" Foreground="#AFFFFFFF" FontSize="9" Margin="7,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="WeatherStatusIcon" Grid.Column="1" Text="&#x2601;" FontFamily="Segoe UI Symbol" Foreground="#EFFFFFFF" FontSize="14"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="WeatherTemperatureText" Text="26°" Foreground="#FFFFFFFF" FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WeatherConditionText" Grid.Column="1" Text="多云" Foreground="#E8FFFFFF" FontSize="11" Margin="10,0,0,2" VerticalAlignment="Bottom"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="WeatherHighLowText" Text="最高 27°  最低 24°" Foreground="#D8FFFFFF" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="WeatherUpdatedText" Text="正在更新" Foreground="#85FFFFFF" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center"><TextBlock x:Name="ForecastDay1" Text="今天" Foreground="#BFFFFFFF" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastIcon1" Text="&#x2601;" FontFamily="Segoe UI Symbol" Foreground="#F2FFFFFF" FontSize="13" Margin="0,3" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastTemp1" Text="26°" Foreground="#E8FFFFFF" FontSize="8" HorizontalAlignment="Center"/></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock x:Name="ForecastDay2" Text="明天" Foreground="#BFFFFFFF" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastIcon2" Text="&#x2600;" FontFamily="Segoe UI Symbol" Foreground="#F2FFFFFF" FontSize="13" Margin="0,3" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastTemp2" Text="27°" Foreground="#E8FFFFFF" FontSize="8" HorizontalAlignment="Center"/></StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock x:Name="ForecastDay3" Text="周四" Foreground="#BFFFFFFF" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastIcon3" Text="&#x2601;" FontFamily="Segoe UI Symbol" Foreground="#F2FFFFFF" FontSize="13" Margin="0,3" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastTemp3" Text="26°" Foreground="#E8FFFFFF" FontSize="8" HorizontalAlignment="Center"/></StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center"><TextBlock x:Name="ForecastDay4" Text="周五" Foreground="#BFFFFFFF" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastIcon4" Text="&#x2602;" FontFamily="Segoe UI Symbol" Foreground="#F2FFFFFF" FontSize="13" Margin="0,3" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastTemp4" Text="25°" Foreground="#E8FFFFFF" FontSize="8" HorizontalAlignment="Center"/></StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center"><TextBlock x:Name="ForecastDay5" Text="周六" Foreground="#BFFFFFFF" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastIcon5" Text="&#x2601;" FontFamily="Segoe UI Symbol" Foreground="#F2FFFFFF" FontSize="13" Margin="0,3" HorizontalAlignment="Center"/><TextBlock x:Name="ForecastTemp5" Text="26°" Foreground="#E8FFFFFF" FontSize="8" HorizontalAlignment="Center"/></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ClockCard" Grid.Row="2" Width="124" HorizontalAlignment="Left" Style="{StaticResource WidgetCardStyle}" Padding="7">
            <Canvas Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="106" Height="106" Stroke="#B8FFFFFF" StrokeThickness="1" Canvas.Left="1" Canvas.Top="1"/>
                <TextBlock Text="12" Foreground="#F4FFFFFF" FontSize="10" Canvas.Left="47" Canvas.Top="4"/>
                <TextBlock Text="1" Foreground="#E4FFFFFF" FontSize="9" Canvas.Left="76" Canvas.Top="11"/>
                <TextBlock Text="2" Foreground="#E4FFFFFF" FontSize="9" Canvas.Left="93" Canvas.Top="28"/>
                <TextBlock Text="3" Foreground="#F4FFFFFF" FontSize="10" Canvas.Left="98" Canvas.Top="48"/>
                <TextBlock Text="4" Foreground="#E4FFFFFF" FontSize="9" Canvas.Left="93" Canvas.Top="72"/>
                <TextBlock Text="5" Foreground="#E4FFFFFF" FontSize="9" Canvas.Left="77" Canvas.Top="88"/>
                <TextBlock Text="6" Foreground="#F4FFFFFF" FontSize="10" Canvas.Left="51" Canvas.Top="94"/>
                <TextBlock Text="7" Foreground="#E4FFFFFF" FontSize="9" Canvas.Left="28" Canvas.Top="88"/>
                <TextBlock Text="8" Foreground="#E4FFFFFF" FontSize="9" Canvas.Left="11" Canvas.Top="72"/>
                <TextBlock Text="9" Foreground="#F4FFFFFF" FontSize="10" Canvas.Left="5" Canvas.Top="48"/>
                <TextBlock Text="10" Foreground="#E4FFFFFF" FontSize="9" Canvas.Left="9" Canvas.Top="28"/>
                <TextBlock Text="11" Foreground="#E4FFFFFF" FontSize="9" Canvas.Left="25" Canvas.Top="11"/>
                <Line X1="54" Y1="54" X2="54" Y2="29" Stroke="#FFFFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Line.RenderTransform><RotateTransform x:Name="HourHandRotate" CenterX="54" CenterY="54"/></Line.RenderTransform></Line>
                <Line X1="54" Y1="54" X2="54" Y2="18" Stroke="#F6FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Line.RenderTransform><RotateTransform x:Name="MinuteHandRotate" CenterX="54" CenterY="54"/></Line.RenderTransform></Line>
                <Line X1="54" Y1="59" X2="54" Y2="15" Stroke="#FFF2B9B9" StrokeThickness="1" StrokeStartLineCap="Round"><Line.RenderTransform><RotateTransform x:Name="SecondHandRotate" CenterX="54" CenterY="54"/></Line.RenderTransform></Line>
                <Ellipse Width="7" Height="7" Fill="#FFFFFFFF" Canvas.Left="50.5" Canvas.Top="50.5"/>
            </Canvas>
        </Border>

        <Border x:Name="CalendarCard" Grid.Row="4" Width="124" HorizontalAlignment="Left" Style="{StaticResource WidgetCardStyle}" Padding="9,7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CalendarMonthText" Text="七月" Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="CalendarYearText" Grid.Column="1" Text="2026" Foreground="#9FFFFFFF" FontSize="8" VerticalAlignment="Center"/></Grid>
                <UniformGrid Grid.Row="1" Rows="1" Columns="7"><TextBlock Text="一" Foreground="#A8FFFFFF" FontSize="7" HorizontalAlignment="Center"/><TextBlock Text="二" Foreground="#A8FFFFFF" FontSize="7" HorizontalAlignment="Center"/><TextBlock Text="三" Foreground="#A8FFFFFF" FontSize="7" HorizontalAlignment="Center"/><TextBlock Text="四" Foreground="#A8FFFFFF" FontSize="7" HorizontalAlignment="Center"/><TextBlock Text="五" Foreground="#A8FFFFFF" FontSize="7" HorizontalAlignment="Center"/><TextBlock Text="六" Foreground="#A8FFFFFF" FontSize="7" HorizontalAlignment="Center"/><TextBlock Text="日" Foreground="#A8FFFFFF" FontSize="7" HorizontalAlignment="Center"/></UniformGrid>
                <UniformGrid x:Name="CalendarDaysPanel" Grid.Row="2" Rows="6" Columns="7"/>
            </Grid>
        </Border>

        <Border x:Name="LockCard" Grid.Row="4" Width="124" HorizontalAlignment="Left" Style="{StaticResource WidgetCardStyle}" Padding="8,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="17"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="#FFFFD8E8" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="今日锁屏" Foreground="#FFFFFFFF" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="LockSessionCountText" Grid.Column="1" Text="0 次" Foreground="#B8FFD6E6" FontSize="7" Margin="0,0,32,0" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="LockTotalText" Grid.Row="1" Text="00:00:00" Foreground="#FFFFFFFF" FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ScrollViewer x:Name="LockSessionsScroll" Grid.Row="2" Margin="0,2,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel x:Name="LockSessionsPanel">
                        <TextBlock x:Name="LockEmptyText" Text="今天尚无活动记录" Foreground="#A8FFD8E8" FontSize="7.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Border x:Name="BatteryCard" Width="124" HorizontalAlignment="Left" Style="{StaticResource WidgetCardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Width="48" Height="48" HorizontalAlignment="Left">
                        <Ellipse Stroke="#B8FFFFFF" StrokeThickness="2"/>
                        <TextBlock x:Name="BatteryIconText" Text="&#xE851;" FontFamily="Segoe Fluent Icons" Foreground="#FFFFFFFF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <TextBlock x:Name="BatteryPercentText" Text="84%" Foreground="#FFFFFFFF" FontFamily="Segoe UI Variable Display" FontSize="29" FontWeight="Light"/>
                        <TextBlock x:Name="BatteryStateText" Text="使用电池" Foreground="#A8FFFFFF" FontSize="8" Margin="1,-2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="MediaCard" Width="440" Height="142" Margin="132,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource WidgetCardStyle}" Padding="12,9">
                <Grid ClipToBounds="True" ToolTip="音乐可视化与影音记录：显示当前电影、音乐、字幕、进度和播放控制">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="292"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="13"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="15" Height="15" Margin="0,0,6,0">
                                <Ellipse Stroke="#BFE7F4D6" StrokeThickness="1"/>
                                <Ellipse x:Name="MediaStatusDot" Width="5" Height="5" Fill="#78FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="音乐可视化" Foreground="#F8FFFFFF" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MediaIdentityText" Visibility="Collapsed" Text="音乐可视化"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaStateText" Text="等待播放" Foreground="#A8FFFFFF" FontSize="7"/>
                            <TextBlock Text=" · " Foreground="#55FFFFFF" FontSize="7"/>
                            <TextBlock x:Name="MediaAppText" Text="系统媒体" Foreground="#A8E7D6C4" FontSize="7" MaxWidth="64" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="MediaLanguageButton" AutomationProperties.Name="字幕识别语言" Content="自动" Margin="5,0,0,0" Style="{StaticResource MediaLanguageButtonStyle}" ToolTip="选择视频、电影或歌曲的原声语言，显示原文和简体中文"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,1,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Background="#342A3A20" BorderBrush="#63E7F4D6" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaGlyphText" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Foreground="#F5FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaTrackText" AutomationProperties.LiveSetting="Polite" Text="暂无播放内容" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MediaArtistText" AutomationProperties.LiveSetting="Polite" Text="打开音乐应用或浏览器开始播放" Foreground="#9FFFFFFF" FontSize="8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid x:Name="MediaVisualizer" Grid.Row="2" Rows="1" Columns="18" Margin="0,2,0,1" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="MediaBar01" Height="3" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Fill="#D0F1FFE8"/>
                        <Rectangle x:Name="MediaBar02" Height="3" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Fill="#D5EAF9DE"/>
                        <Rectangle x:Name="MediaBar03" Height="3" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Fill="#DCE4F3D5"/>
