                        <TextBlock Text="工作台 · 本地配置" Foreground="#B8F0FFCF" FontSize="6" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="CodeModeButton" AutomationProperties.Name="AI 编程模式一键调优" Grid.Column="1" Width="58" Height="19" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="一键调优 AI 编程模式">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="7"/><TextBlock x:Name="CodeModeButtonText" Text="调优" FontSize="6" Margin="3,0,0,0"/></StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="CodeCompletionToggle" Grid.Column="0" Style="{StaticResource TodoCheckStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="智能补全" Foreground="#D8FFFFFF" FontSize="6" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CodeCompletionStateText" Grid.Column="2" Text="开启" Foreground="#B8E9FFC5" FontSize="6" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="终端" Foreground="#D8FFFFFF" FontSize="6" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CodeTerminalCombo" Grid.Column="1" Width="58" Height="18" HorizontalAlignment="Left" FontSize="6" SelectedIndex="1"><ComboBoxItem Content="标准"/><ComboBoxItem Content="高性能"/><ComboBoxItem Content="低干扰"/></ComboBox>
                    <TextBlock Text="本地配置" Grid.Column="2" Foreground="#82FFFFFF" FontSize="6" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="CodeToolchainToggle" Grid.Column="0" Style="{StaticResource TodoCheckStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="工具链提示" Foreground="#D8FFFFFF" FontSize="6" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CodeToolchainStateText" Grid.Column="2" Text="开启" Foreground="#B8E9FFC5" FontSize="6" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="4" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CodeActionStatusText" Text="待机 · 点击调优" Foreground="#9EE7F6D2" FontSize="5.2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="AI 编程模式动作状态"/>
                    <Button x:Name="ModeDeckOpenAIButton" Grid.Column="1" Width="42" Height="18" Content="工作台" FontSize="5.2" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="显示并聚焦 AI 捕捉与行动中心" Margin="2,0,2,0"/>
                    <Button x:Name="ModeDeckResetButton" Grid.Column="2" Width="29" Height="18" Content="重置" FontSize="5.2" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="恢复三种模式的本地参数"/>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="MusicModeCard" Grid.Row="0" Style="{StaticResource WidgetCardStyle}" Padding="8,7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="音乐模式" Foreground="#FFFFFFFF" FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock Text="可视化 · 歌词" Foreground="#E8E1C8FF" FontSize="6" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="MusicModeButton" AutomationProperties.Name="音乐模式一键调优" Grid.Column="1" Width="58" Height="19" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="一键调优音乐模式">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="7"/><TextBlock x:Name="MusicModeButtonText" Text="调优" FontSize="6" Margin="3,0,0,0"/></StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <TextBlock Text="低音" Foreground="#E8FFFFFF" FontSize="6" VerticalAlignment="Center"/>
                    <Slider x:Name="MusicBassSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="70" Height="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MusicBassValueText" Grid.Column="2" Text="70%" Foreground="#F0FFFFFF" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <TextBlock Text="人声" Foreground="#E8FFFFFF" FontSize="6" VerticalAlignment="Center"/>
                    <Slider x:Name="MusicVoiceSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="55" Height="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MusicVoiceValueText" Grid.Column="2" Text="55%" Foreground="#F0FFFFFF" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <TextBlock Text="氛围" Foreground="#E8FFFFFF" FontSize="6" VerticalAlignment="Center"/>
                    <Slider x:Name="MusicAmbienceSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="65" Height="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MusicAmbienceValueText" Grid.Column="2" Text="65%" Foreground="#F0FFFFFF" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="MusicActionStatusText" Grid.Row="4" Text="待机 · 点击调优" Foreground="#E8D8B8FF" FontSize="5.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" ToolTip="音乐模式动作状态"/>
            </Grid>
        </Border>

        <Border x:Name="PhotoCard" Grid.Row="10" Style="{StaticResource WidgetCardStyle}" Padding="0" Background="#F0000000" BorderBrush="#78E5ECF4">
            <Grid x:Name="PhotoViewport" ClipToBounds="True" AllowDrop="True">
                <Grid x:Name="PhotoContentLayer" IsHitTestVisible="False">
                    <Grid.RenderTransform><TranslateTransform x:Name="PhotoSwipeTranslate"/></Grid.RenderTransform>
                    <Image x:Name="PhotoImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
                    <MediaElement x:Name="PhotoVideo" Visibility="Collapsed" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" IsMuted="True"/>
                </Grid>
                <Border x:Name="PhotoSwipeSurface" Margin="0,0,0,44" Background="#01000000" Cursor="Hand"/>
                <Border x:Name="PhotoEmptyOverlay" Background="#E80B0D12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" Foreground="#B8FFFFFF" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PhotoEmptyText" Text="拖入或点击导入微信照片" Foreground="#D8FFFFFF" FontSize="10" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Height="44" VerticalAlignment="Bottom" BorderThickness="0,1,0,0" BorderBrush="#30FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A5101116" Offset="0"/><GradientStop Color="#F008090D" Offset="1"/></LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="10,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <Button x:Name="PhotoImportButton" AutomationProperties.Name="直接导入微信照片" Width="62" Height="28" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="直接选择微信图片、Live Photo 或视频，不用先建文件夹">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons" FontSize="11"/><TextBlock Text="导入" FontSize="9" Margin="5,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock x:Name="PhotoCaptionText" Grid.Column="1" Text="微信生活" Foreground="#DFFFFFFF" FontSize="8" Margin="9,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="PhotoPreviousButton" Grid.Column="2" AutomationProperties.Name="上一张照片" Width="27" Height="27" Content="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="10" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="上一张"/>
                        <Button x:Name="PhotoNextButton" Grid.Column="3" AutomationProperties.Name="下一张照片" Width="27" Height="27" Content="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="下一张"/>
                        <Button x:Name="PhotoLockScreenButton" Grid.Column="4" AutomationProperties.Name="把照片设为锁屏壁纸" Width="27" Height="27" Content="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="10" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="把当前照片设为 Windows 锁屏壁纸"/>
                        <Button x:Name="PhotoOpenButton" Grid.Column="5" AutomationProperties.Name="打开微信生活图片文件夹" Width="27" Height="27" Content="&#xE838;" FontFamily="Segoe Fluent Icons" FontSize="10" Style="{StaticResource WidgetIconButtonStyle}" ToolTip="左键打开 图片\微信生活；右键定位当前照片"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
