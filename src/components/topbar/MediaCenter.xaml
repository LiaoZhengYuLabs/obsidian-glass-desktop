<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面媒体中心"
        Width="760" Height="620"
        MinWidth="680" MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#E815171B"/>
    <SolidColorBrush x:Key="TileBrush" Color="#C521242B"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#E42B3038"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F7FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#AEB7C2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7CD8F2"/>

    <Style x:Key="TopTabStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TabBorder" CornerRadius="8" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#25313A44"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#071014"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="17,9"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ActionBorder" CornerRadius="8" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ActionBorder" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                </Setter>
                <Setter TargetName="ActionBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#30343D47"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="RecordingToggleStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Background" Value="#34414A"/>
      <Setter Property="BorderBrush" Value="#6677838C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTip" Value="开始或停止屏幕录像"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleTrack" CornerRadius="12" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Ellipse x:Name="ToggleThumb" Width="18" Height="18" Margin="2"
                       Fill="#F4F7FA" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack" Property="Background" Value="#C6465662"/>
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#FFF18B96"/>
                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="ToggleThumb" Property="Fill" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MediaTileStyle" TargetType="Button">
      <Setter Property="Width" Value="156"/>
      <Setter Property="Height" Value="148"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="Background" Value="{StaticResource TileBrush}"/>
      <Setter Property="BorderBrush" Value="#38424D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TileBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TileBorder" Property="Background" Value="{StaticResource TileHoverBrush}"/>
                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#7194A4B4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="18" Background="{StaticResource PanelBrush}" BorderBrush="#566C7D8A" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="12" Opacity="0.58"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="48"/>
        <RowDefinition Height="58"/>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="34"/>
      </Grid.RowDefinitions>

      <Grid x:Name="DragHeader" Grid.Row="0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="20,10,0,7">
          <TextBlock Text="桌面媒体中心" Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI"
                     FontWeight="SemiBold" FontSize="16"/>
          <TextBlock x:Name="HeaderSubtitle" Text="截图、录像与摄像头历史" Foreground="{StaticResource MutedBrush}"
                     FontFamily="Microsoft YaHei UI" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,10,12,10">
          <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0" ToolTip="隐藏"/>
          <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource IconButtonStyle}" ToolTip="关闭"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" BorderBrush="#26303A43" BorderThickness="0,1,0,1">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="ScreenshotTabButton" Content="截图" Style="{StaticResource TopTabStyle}"/>
          <Button x:Name="RecordingTabButton" Content="录像" Style="{StaticResource TopTabStyle}"/>
          <Button x:Name="CameraTabButton" Content="摄像头" Style="{StaticResource TopTabStyle}"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" Margin="16,10,16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="PrimaryActionButton" Grid.Column="0" Content="立即截图" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
        <Button x:Name="SecondaryActionButton" Grid.Column="1" Content="区域截图" Style="{StaticResource SecondaryButtonStyle}"/>
        <Border x:Name="RecordingControlPanel" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="10,0" Padding="9,6" CornerRadius="8"
                Background="#43252B31" BorderBrush="#536A747D" BorderThickness="1">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="RecordingStatusDot" Width="7" Height="7" Fill="#6677838C" Margin="0,0,6,0"/>
            <TextBlock x:Name="RecordingStateText" Text="未录制" Width="42" Foreground="{StaticResource MutedBrush}"
                       FontFamily="Microsoft YaHei UI" FontSize="11" VerticalAlignment="Center"/>
            <ToggleButton x:Name="RecordingToggleButton" IsChecked="False" Style="{StaticResource RecordingToggleStyle}"/>
            <TextBlock x:Name="RecordingDurationText" Text="00:00:00" Foreground="{StaticResource TextBrush}"
                       FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Button x:Name="OpenFolderButton" Grid.Column="3" Content="打开文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
        <Button x:Name="AddFolderButton" Grid.Column="4" Content="新建文件夹" Style="{StaticResource SecondaryButtonStyle}"/>
      </Grid>

      <Grid Grid.Row="3" Margin="16,2,16,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="UpButton" Grid.Column="0" Content="&#xE72B;" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0" ToolTip="返回上一级"/>
        <TextBlock x:Name="BreadcrumbText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                   FontFamily="Microsoft YaHei UI" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="RefreshButton" Grid.Column="2" Content="&#xE72C;" Style="{StaticResource IconButtonStyle}" ToolTip="刷新"/>
      </Grid>

      <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,8,0">
        <ItemsControl x:Name="MediaItemsControl">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Left"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource MediaTileStyle}" Tag="{Binding FullPath}">
                <Grid Margin="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="18"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" CornerRadius="6" Background="#15171C" ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                      <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                 Foreground="#8EDCF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border Background="#B4121418" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" Margin="5" Visibility="{Binding BadgeVisibility}">
                        <TextBlock Text="{Binding Badge}" Foreground="#EAF8FF" FontFamily="Microsoft YaHei UI" FontSize="10"/>
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                             FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}"
                             FontFamily="Microsoft YaHei UI" FontSize="10" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="5" BorderBrush="#26303A43" BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}" FontFamily="Microsoft YaHei UI"
                     FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="ItemCountText" Grid.Column="1" Text="0 项" Foreground="{StaticResource MutedBrush}"
                     FontFamily="Microsoft YaHei UI" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
